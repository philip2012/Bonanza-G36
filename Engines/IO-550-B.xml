<piston_engine name="IO-550-B">
  <minmp unit="INHG">         10.0 </minmp>
  <maxmp unit="INHG">         28.5 </maxmp>
    <displacement unit="IN3"> 552 </displacement>
  <maxhp>        300 </maxhp>
  <cycles>         4.0 </cycles>
  <idlerpm>      700.0 </idlerpm>
  <maxrpm> 2700 </maxrpm>
  <sparkfaildrop>  0.1 </sparkfaildrop>
  <volumetric-efficiency> 0.85 </volumetric-efficiency>
  <man-press-lag> 0.1 </man-press-lag>
  <static-friction  unit="HP"> 1.5 </static-friction>
  <starter-torque> 240 </starter-torque>
  <starter-rpm> 1400 </starter-rpm>
 <!-- Defining <bsfc> over-rides the built-in horsepower calculations -->
 <!--<bsfc>           0.45 </bsfc>-->
  <stroke unit="IN"> 4.25 </stroke>
  <bore unit="IN"> 5.25 </bore>
  <cylinders>         6  </cylinders>
  <compression-ratio> 8.5 </compression-ratio>
</piston_engine>
